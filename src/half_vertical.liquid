{% if status == "success" %}
<div class="layout layout--col">
  <div class="flex flex--row flex--stretch w--full">
    <div class="flex flex--center-x">
      <img class="image--adaptive" src="https://raw.githubusercontent.com/dnguyen800/air-visual-card/refs/heads/master/dist/{{ aqi_icon }}">
    </div>
    <div class="flex flex--col">
      <div><span class="value value--tnums">{{ aqi_level }}</span></div>
      <div><span class="label">{{ aqi_pollution }}</span></div>
      <div><span class="value value--tnums">{{ data.current.pollution.aqius }}</span></div>
      <div><span class="label">AQI</span></div>
    </div>
  </div>
  <div class="flex flex--row gap--xxlarge p--5">
    <div>
      <span class="text--large">{{ aqi_descr }}</span>
    </div>
  </div>
</div>
{% else %}
Error loading data: {{ status }}
{% endif %}

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">IQAir AirVisual</span>
  <span class="instance">{{ data.city }} @ {{ data.current.pollution.ts | date: "%s" | plus: trmnl.user.utc_offset | date: "%F %H:%M" }}</span>
</div>